---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const articles = (await getCollection("articles")).sort(
    (a, b) => b.data.published.getTime() - a.data.published.getTime(),
  );
  // next read = the one below it on the home list, wrapping to the top.
  // Articles dated after the build aren't on the list yet, so they point to the top of it.
  const now = Date.now();
  const listed = articles.filter((a) => a.data.published.getTime() <= now);
  return articles.map((article) => {
    const i = listed.indexOf(article);
    return {
      params: { slug: article.id },
      props: { article, next: i === -1 ? listed[0] : listed[(i + 1) % listed.length] },
    };
  });
}

const { article, next } = Astro.props;
const { Content } = await render(article);
const { title, summary, published, youtube, instagram } = article.data;
const date = published.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
---

<Base title={title} description={summary}>
  <div class="progress" aria-hidden="true"><span></span></div>
  <header class="wrap top">
    <div class="column"><a class="back" href="/">Prune Labs</a></div>
  </header>
  <main class="wrap">
    <article class="sheet paper">
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      <p class="meta">
        <time datetime={published.toISOString()}>{date}</time>
        {youtube && <a href={youtube}>Watch on YouTube</a>}
        {instagram && <a href={instagram}>Watch on Instagram</a>}
      </p>
      <div class="body"><Content /></div>
    </article>
    <nav class="after" aria-label="Keep reading">
      <a class="next paper" href={`/a/${next.id}/`}>
        <span>Next read</span>
        <strong>{next.data.title}</strong>
      </a>
      <a class="prism" href="/prism/">
        <strong>Prism</strong>
        <span>The tool that watched my 147 saved reels for me. Join the waitlist.</span>
      </a>
    </nav>
  </main>
</Base>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  // reading progress: the cut line across the top turns solid as you read
  gsap.registerPlugin(ScrollTrigger);
  gsap.to(".progress span", {
    scaleX: 1,
    ease: "none",
    scrollTrigger: { trigger: ".sheet", start: "top top", end: "bottom bottom", scrub: 0.3 },
  });

  // Copy button on every code block: the commands are the reason people open these pages.
  document.querySelectorAll<HTMLPreElement>(".body pre").forEach((pre) => {
    const button = document.createElement("button");
    button.type = "button";
    button.className = "copy";
    button.textContent = "Copy";
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(pre.querySelector("code")?.innerText ?? pre.innerText);
        button.textContent = "Copied";
      } catch {
        button.textContent = "Select and copy";
      }
      setTimeout(() => (button.textContent = "Copy"), 1600);
    });
    pre.append(button);
  });
</script>

<style>
  .progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 10;
    height: 4px;
    background: repeating-linear-gradient(90deg, var(--paper-line) 0 8px, transparent 8px 14px);
  }
  .progress span {
    display: block;
    height: 100%;
    background: var(--clay);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }
  .top {
    padding-top: 28px;
    padding-bottom: 28px;
  }
  .column {
    max-width: 880px;
    margin: 0 auto;
  }
  .back {
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
    font-size: 18px;
  }
  .back::before {
    content: "← ";
  }
  .sheet {
    max-width: 880px;
    margin: 0 auto;
    padding: clamp(20px, 5vw, 72px);
  }
  h1 {
    margin: 0 0 20px;
    font-size: clamp(34px, 5.6vw, 68px);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 700;
    text-wrap: balance;
  }
  .summary {
    margin: 0 0 22px;
    font-size: clamp(20px, 1rem + 0.6vw, 25px);
    line-height: 1.45;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 0 0 44px;
    color: var(--muted);
    font-size: 16px;
  }
  .meta a {
    color: var(--ink);
  }
  /* reading size: 18px on a phone, 21px on a desktop monitor */
  .body {
    font-size: clamp(18px, 0.9rem + 0.45vw, 21px);
    line-height: 1.65;
  }
  .body :global(h2) {
    margin: 56px 0 14px;
    font-size: clamp(26px, 1.2rem + 1.2vw, 38px);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }
  .body :global(p),
  .body :global(li) {
    max-width: 68ch;
  }
  .body :global(li + li) {
    margin-top: 8px;
  }
  .body :global(a) {
    text-decoration-color: var(--clay);
    text-underline-offset: 3px;
  }
  .body :global(:not(pre) > code) {
    font-size: 0.88em;
    background: var(--grid-minor);
    padding: 1px 5px;
  }
  .body :global(pre) {
    position: relative;
    margin: 24px 0;
    padding: 22px 24px;
    padding-right: 92px;
    background: var(--ink) !important;
    color: #f4f4f2;
    font-size: clamp(14px, 0.75rem + 0.2vw, 16px);
    line-height: 1.6;
    overflow-x: auto;
  }
  .body :global(pre code) {
    background: none;
  }
  .body :global(.copy) {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 6px 12px;
    border: 0;
    background: #2b2b29;
    color: #f4f4f2;
    font: 600 13px/1 var(--sans);
    cursor: pointer;
    transition: background-color 160ms var(--ease-out), transform 120ms var(--ease-out);
  }
  .body :global(.copy:hover) {
    background: var(--clay);
  }
  .body :global(.copy:active) {
    transform: scale(0.96);
  }
  .body :global(blockquote) {
    font-size: 1.1em;
    margin: 24px 0;
    padding: 4px 0 4px 18px;
    border-left: 4px solid var(--clay);
    font-weight: 600;
  }

  .after {
    display: grid;
    gap: 12px;
    max-width: 880px;
    margin: 28px auto 0;
  }
  @media (min-width: 760px) {
    .after {
      grid-template-columns: 1fr 1fr;
    }
  }
  .after a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 24px;
    text-decoration: none;
    transition: transform 220ms var(--ease-out), background-color 180ms var(--ease-out);
  }
  .after strong {
    font-size: clamp(20px, 1rem + 0.6vw, 24px);
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
  .next span {
    color: var(--muted);
    font-size: 15px;
  }
  .prism {
    background: var(--clay-ink);
    color: #fff;
  }
  .prism strong {
    font-size: clamp(28px, 1.2rem + 1.5vw, 40px);
    letter-spacing: -0.04em;
  }
  .prism:hover {
    background: var(--clay-press);
  }
  @media (hover: hover) {
    .after a:hover {
      transform: translateY(-3px);
    }
  }
</style>
