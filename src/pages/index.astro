---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Buddy from "../components/Buddy.astro";
import { site } from "../site";

// Articles dated after the build stay off the list (their reel hasn't aired yet); /a/<slug> still works for DM links.
// ponytail: listed only after a rebuild on or after that date; add a scheduled deploy if that lag matters.
const now = Date.now();
const [featured, ...moreVideos] = site.videos;
const articles = (await getCollection("articles"))
  .filter((a) => a.data.published.getTime() <= now)
  .sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
---

<Base>
  <main class="wrap hub">
    <header class="intro">
      <div class="name">
        <h1>Prune Labs</h1>
        <button class="hi" type="button" aria-label="Say hi to the Prune Labs buddy">
          <Buddy size="clamp(76px, 9vw, 128px)" gaze={20} />
        </button>
      </div>
      <p class="lede">
        I test developer and AI tools on real projects, then keep only what works. The notes, setups and links from
        every video live here.
      </p>
      <p class="socials">
        <a href={site.youtube}>YouTube</a>
        <a href={site.instagram}>Instagram</a>
        <a href={site.github}>GitHub</a>
      </p>

      <section class="watch" aria-labelledby="watch">
        <h2 id="watch" class="label">Watch</h2>
        <a class="player" href={`https://www.youtube.com/watch?v=${featured.id}`} data-yt={featured.id}>
          <span class="screen">
            <img src={`https://i.ytimg.com/vi/${featured.id}/maxresdefault.jpg`} alt="" width="1280" height="720" />
            <span class="play" aria-hidden="true"></span>
          </span>
          <strong>{featured.title}</strong>
          <span>{featured.meta}</span>
        </a>
        <ul class="list">
          {
            moreVideos.map((v) => (
              <li>
                <a class="strip paper" href={`https://www.youtube.com/watch?v=${v.id}`}>
                  <strong>{v.title}</strong>
                  <span>{v.meta}</span>
                </a>
              </li>
            ))
          }
          <li>
            <a class="strip paper" href={site.youtube}>
              <strong>All videos on YouTube</strong>
              <span>@prunelabsco</span>
            </a>
          </li>
        </ul>
      </section>
    </header>

    <div class="cuts">
      <section aria-labelledby="prism">
        <div class="keep-wrap">
          <svg class="cutline" aria-hidden="true">
            <mask id="cut-reveal">
              <rect x="0" y="0" width="100%" height="100%" pathLength="100"></rect>
            </mask>
            <rect x="0" y="0" width="100%" height="100%" mask="url(#cut-reveal)"></rect>
          </svg>
          <a class="strip keep" href="/prism/">
            <h2 id="prism">Prism</h2>
            <span>The tool that watched my 147 saved reels for me. Join the waitlist.</span>
          </a>
        </div>
      </section>

      <section aria-labelledby="read">
        <h2 id="read" class="label">Read</h2>
        <ul class="list">
          {
            articles.map((article) => (
              <li>
                <a class="strip paper" href={`/a/${article.id}/`}>
                  <strong>{article.data.title}</strong>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      {
        site.kofi && (
          <section aria-labelledby="support">
            <h2 id="support" class="label">Support</h2>
            <a class="strip paper" href={site.kofi}>
              <strong>Buy me a coffee on Ko-fi</strong>
              <span>Keeps the tests running</span>
            </a>
          </section>
        )
      }
    </div>
  </main>
</Base>

<script>
  import { gsap } from "gsap";
  import { SplitText } from "gsap/SplitText";
  import { buddy } from "../buddy";

  gsap.registerPlugin(SplitText);

  // the buddy glances at whatever link you point at, and says "!" when you poke it
  const b = buddy(document.querySelector<SVGSVGElement>(".hi .buddy")!);
  b.enter(0.55);
  document.querySelectorAll(".strip, .player").forEach((strip) => {
    strip.addEventListener("pointerenter", () => b.look(strip));
    strip.addEventListener("focus", () => b.look(strip));
    strip.addEventListener("pointerleave", () => b.rest());
    strip.addEventListener("blur", () => b.rest());
  });
  document.querySelector(".hi")!.addEventListener("click", () => b.wow());

  // lite embed: only a thumbnail until clicked, then the real (no-cookie) player takes its place.
  // Without JS, or with a modifier key, the link just opens YouTube.
  const player = document.querySelector<HTMLAnchorElement>(".player")!;
  player.addEventListener("click", (e) => {
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
    e.preventDefault();
    const frame = document.createElement("iframe");
    frame.src = `https://www.youtube-nocookie.com/embed/${player.dataset.yt}?autoplay=1&rel=0`;
    frame.title = player.querySelector("strong")!.textContent!;
    frame.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
    frame.allowFullscreen = true;
    player.querySelector(".screen")!.replaceChildren(frame);
    player.removeAttribute("href");
    player.classList.add("on");
  });

  const keep = document.querySelector(".keep")!;
  const mm = gsap.matchMedia();
  mm.add("(prefers-reduced-motion: no-preference)", () => {
    const split = SplitText.create(".name h1", { type: "words,chars", mask: "chars" });
    gsap.from(split.chars, { yPercent: 110, duration: 0.7, ease: "power4.out", stagger: 0.035 });
    // Prism is cut out of the mat, then lifts off it
    gsap
      .timeline({ delay: 0.45 })
      .fromTo("#cut-reveal rect", { strokeDashoffset: 100 }, { strokeDashoffset: 0, duration: 0.9, ease: "power2.inOut" })
      .add(() => keep.classList.add("cut"));
    return () => split.revert();
  });
  mm.add("(prefers-reduced-motion: reduce)", () => keep.classList.add("cut"));
</script>

<style>
  .hub {
    display: grid;
    gap: 48px;
    padding-top: clamp(40px, 8vw, 96px);
  }
  @media (min-width: 900px) {
    .hub {
      grid-template-columns: 5fr 7fr;
      gap: 64px;
      align-items: start;
    }
  }
  .name {
    display: flex;
    align-items: flex-end;
    gap: clamp(12px, 2vw, 24px);
    margin: 0 0 20px;
  }
  .hi {
    flex: none;
    margin: 0 0 4px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  h1 {
    min-width: 0;
    margin: 0;
    font-size: clamp(56px, 7.2vw, 104px);
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-weight: 750;
  }
  .lede {
    max-width: 30ch;
    margin: 0 0 24px;
    font-size: clamp(19px, 2vw, 23px);
    line-height: 1.4;
  }
  .socials {
    display: flex;
    gap: 22px;
    margin: 0;
    font-weight: 600;
  }
  .socials a {
    text-underline-offset: 4px;
  }
  .socials a:hover {
    text-decoration-color: var(--clay);
  }

  .watch {
    margin-top: clamp(40px, 6vw, 64px);
  }
  .watch .list {
    margin-top: 10px;
  }
  /* the latest episode, playable in place. Same paper + cut line as the strips. */
  .player {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 10px 18px;
    text-decoration: none;
    background: var(--paper);
    outline: 1.5px dashed var(--paper-line);
    outline-offset: -1.5px;
    transition: outline-color 220ms var(--ease-out);
  }
  .player:hover,
  .player:focus-visible {
    outline-color: var(--ink);
  }
  .player strong {
    margin: 12px 10px 0;
    font-size: 19px;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .player > span:last-child {
    margin: 0 10px;
    color: var(--muted);
    font-size: 15px;
  }
  .screen {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--ink);
  }
  .screen img,
  .screen iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }
  /* the play button is the buddy's body: a black rounded box */
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 76px;
    height: 54px;
    margin: -27px 0 0 -38px;
    border-radius: 16px;
    background: var(--ink);
    transition:
      background-color 180ms var(--ease-out),
      transform 220ms var(--ease-out);
  }
  .play::after {
    content: "";
    position: absolute;
    left: 31px;
    top: 16px;
    border-left: 20px solid #fff;
    border-top: 11px solid transparent;
    border-bottom: 11px solid transparent;
  }
  .player:hover .play {
    background: var(--clay-ink);
    transform: scale(1.06);
  }
  .player:active .play {
    transform: scale(0.97);
  }

  .cuts {
    display: grid;
    gap: 40px;
  }
  .label {
    margin: 0 0 12px;
    font-size: 22px;
    letter-spacing: -0.02em;
  }
  .list {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* a strip of paper cut from the mat */
  .strip {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 18px 20px;
    min-height: 60px;
    text-decoration: none;
    transition:
      transform 220ms var(--ease-out),
      border-color 220ms var(--ease-out);
  }
  .strip strong {
    font-size: 19px;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .strip span {
    color: var(--muted);
    font-size: 15px;
  }
  /* the cut line is drawn as four dashed edges so it can march like a blade on hover */
  .strip.paper {
    --cut: var(--paper-line);
    border: 0;
    padding: 19.5px 21.5px;
    background:
      linear-gradient(90deg, var(--cut) 8px, transparent 0) 0 0 / 14px 1.5px repeat-x,
      linear-gradient(90deg, var(--cut) 8px, transparent 0) 0 100% / 14px 1.5px repeat-x,
      linear-gradient(var(--cut) 8px, transparent 0) 0 0 / 1.5px 14px repeat-y,
      linear-gradient(var(--cut) 8px, transparent 0) 100% 0 / 1.5px 14px repeat-y,
      var(--paper);
  }
  .strip.paper:hover,
  .strip.paper:focus-visible {
    --cut: var(--ink);
  }
  @media (prefers-reduced-motion: no-preference) {
    .strip.paper:hover {
      animation: march 0.7s linear infinite;
    }
  }
  @keyframes march {
    to {
      background-position:
        14px 0,
        -14px 100%,
        0 -14px,
        100% 14px;
    }
  }
  @media (hover: hover) {
    .strip:hover {
      transform: translateX(6px);
    }
  }
  .strip:active {
    transform: scale(0.99);
  }

  /* the one thing worth keeping: the only clay on the page */
  .keep {
    background: var(--clay-ink);
    color: #fff;
    padding: 26px 24px;
  }
  .keep h2 {
    margin: 0 0 4px;
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .keep span {
    color: #fff;
    font-size: 18px;
    max-width: 36ch;
  }
  .keep:hover {
    background: var(--clay-press);
  }
  .keep-wrap {
    position: relative;
  }
  .cutline {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .cutline > rect {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-dasharray: 8 6;
  }
  .cutline mask rect {
    fill: none;
    stroke: #fff;
    stroke-width: 6;
    stroke-dasharray: 100;
  }
  .keep {
    position: relative;
    transition:
      translate 420ms var(--ease-out),
      box-shadow 420ms var(--ease-out),
      background-color 180ms var(--ease-out),
      transform 220ms var(--ease-out);
  }
  .keep.cut {
    translate: -5px -5px;
    box-shadow: 5px 5px 0 rgba(21, 21, 21, 0.14);
  }

  @media (prefers-reduced-motion: no-preference) {
    .cuts > section {
      animation: rise 520ms var(--ease-out) both;
    }
    .cuts > section:nth-child(2) {
      animation-delay: 70ms;
    }
    .cuts > section:nth-child(3) {
      animation-delay: 140ms;
    }
    .cuts > section:nth-child(4) {
      animation-delay: 210ms;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
</style>
